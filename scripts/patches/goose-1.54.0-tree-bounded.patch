+#[cfg(test)]
+mod bounded_count_tests {
+    use super::*;
+    #[test]
+    fn huge_single_line_is_streamed() {
+        assert_eq!(count_utf8_lines(std::io::repeat(b'x').take(64 * 1024 * 1024)).unwrap(), 1);
+    }
+    #[test]
+    fn utf8_and_line_semantics_are_preserved() {
