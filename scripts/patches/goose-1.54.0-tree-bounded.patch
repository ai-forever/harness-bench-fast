+
+fn count_utf8_lines(mut reader: impl Read) -> std::io::Result<usize> {
+    let mut buffer = [0u8; 65540];
+    let mut pending = 0;
+    let mut lines = 0;
+    let mut nonempty = false;
+    let mut last = 0;
+    loop {
+        let n = reader.read(&mut buffer[pending..65536])?;
+        if n == 0 { break; }
+        nonempty = true;
+        last = buffer[pending + n - 1];
+        lines += buffer[pending..pending+n].iter().filter(|&&b| b == b'\n').count();
+        let used = pending + n;
+        let valid = match std::str::from_utf8(&buffer[..used]) {
+            Ok(_) => used,
+            Err(error) if error.error_len().is_none() => error.valid_up_to(),
+            Err(_) => return Ok(0),
+        };
+        buffer.copy_within(valid..used, 0);
+        pending = used - valid;
+    }
+    if pending != 0 { return Ok(0); }
+    Ok(lines + usize::from(nonempty && last != b'\n'))
