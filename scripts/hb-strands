#!/usr/bin/env bash
# Disposable Strands runner for HBF. Invoke directly so bwrap mounts this file.
set -euo pipefail

fail() {
  # Codes are fixed literals; never include prompts, credentials or env values.
  printf '{"type":"strands_result","schema_version":1,"strands_status":"failed","failure_kind":"infrastructure","retryable":false,"error":"%s","stats":{},"usage_complete":false}\n' "$1"
  exit 2
}

[[ $# -eq 1 ]] || fail launcher_expected_one_prompt
[[ -n "$1" ]] || fail launcher_empty_prompt
if [[ ! ${STRANDS_RUNNER+x} ]]; then
  # Resolve relative to this launcher, never to the task workspace. The cd is
  # confined to a subshell so native tools retain HBF's task cwd.
  strands_repo="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd -P)" || fail launcher_installation_unavailable
  export STRANDS_RUNNER="$strands_repo/harness_bench/strands/runner.mjs"
  [[ -f "$STRANDS_RUNNER" && -r "$STRANDS_RUNNER" ]] || fail launcher_bundled_runner_missing
  for strands_package in @strands-agents/harness @strands-agents/sdk undici; do
    [[ -r "$strands_repo/harness_bench/strands/node_modules/$strands_package/package.json" ]] || fail launcher_missing_dependencies_run_npm_ci_in_harness_bench_strands
  done
fi
[[ "${STRANDS_RUNNER:-}" = /* ]] || fail launcher_requires_absolute_STRANDS_RUNNER
[[ -f "$STRANDS_RUNNER" && -r "$STRANDS_RUNNER" ]] || fail launcher_unreadable_STRANDS_RUNNER

strands_node="${STRANDS_NODE:-}"
if [[ -z "$strands_node" ]]; then
  strands_node="$(command -v node || true)"
elif [[ "$strands_node" != */* ]]; then
  strands_node="$(command -v "$strands_node" || true)"
fi
[[ "$strands_node" = /* && -f "$strands_node" && -x "$strands_node" ]] || fail launcher_node_not_found
strands_node_version="$("$strands_node" -p 'process.versions.node' 2>/dev/null)" || fail launcher_node_version_failed
[[ "$strands_node_version" =~ ^([0-9]+)\. ]] || fail launcher_invalid_node_version
(( BASH_REMATCH[1] >= 22 )) || fail launcher_requires_node_22

# The native profile disables the environment plugin, so give file tools an
# explicit absolute workspace. printf arguments preserve the task byte-for-byte
# (including trailing newlines) without evaluating any of its shell syntax.
strands_workspace="$(pwd -P)" || fail launcher_workspace_unavailable
printf -v STRANDS_INSTRUCTION 'Working directory: %s\nResolve all relative task paths against this directory.\n\n%s' "$strands_workspace" "$1"
export STRANDS_INSTRUCTION
# Bounded smoke defaults only. Explicit caller settings (including invalid empty
# values) reach runner validation unchanged; benchmark budgets must be selected.
export STRANDS_MAX_STEPS="${STRANDS_MAX_STEPS-32}"
export STRANDS_TIMEOUT_SECONDS="${STRANDS_TIMEOUT_SECONDS-600}"
export STRANDS_REQUEST_TIMEOUT_SECONDS="${STRANDS_REQUEST_TIMEOUT_SECONDS-120}"
if [[ ! ${STRANDS_MODEL_PARAMS_JSON+x} ]]; then
  export STRANDS_MODEL_PARAMS_JSON='{"temperature":0,"max_tokens":4096}'
fi
# The runner validates endpoint, model, key, budgets and sampling parameters.
# Do not cd: HBF's task workspace is the root for all native file/shell tools.
# exec keeps cancellation attached to the actual runner process.
exec "$strands_node" "$STRANDS_RUNNER"
